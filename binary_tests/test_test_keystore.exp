#!/usr/bin/env expect
#
# test_test_keystore.exp - interactive happy path for the `test-keystore`
# command, verifying that the keystore fixture decrypts with its password.

source [file join [file dirname [info script]] lib.exp]

spawn_cli test-keystore

expect_or_fail {location of your keystore file} {
    send_line $env(KEYSTORE_PATH)
}
expect_or_fail {password that is used to encrypt the provided keystore} {
    send_line $env(KEYSTORE_PASSWORD)
}

expect_or_fail {Verifying your keystore file}
expect_or_fail {successfully decrypted with the provided password}

expect_or_fail {Press any key} press_any_key
expect_exit_zero
