#!/usr/bin/env expect
#
# test_generate_bls_to_execution_change_keystore.exp - interactive happy path for
# the `generate-bls-to-execution-change-keystore` command, signing with the
# keystore fixture produced by existing_mnemonic.

source [file join [file dirname [info script]] lib.exp]

spawn_cli generate-bls-to-execution-change-keystore --output_folder $env(WORK_DIR)

expect_or_fail {network/chain name} accept_default

expect_or_fail {location of your keystore file} {
    send_line $env(KEYSTORE_PATH)
}
expect_or_fail {password that is used to encrypt the provided keystore} {
    send_line $env(KEYSTORE_PASSWORD)
}
expect_or_fail {validator index number of your validator} {
    send_line 0
}
expect_or_fail {withdrawal address} {
    send_line $env(WITHDRAWAL_ADDRESS)
}
expect_or_fail {Repeat your withdrawal address for confirmation} {
    send_line $env(WITHDRAWAL_ADDRESS)
}

# Signature creation, verification, success message and final pause.
expect_success_end