#!/usr/bin/env expect
#
# test_exit_transaction_keystore.exp - interactive happy path for the
# `exit-transaction-keystore` command, signing an exit with the keystore fixture
# produced by existing_mnemonic.

source [file join [file dirname [info script]] lib.exp]

spawn_cli exit-transaction-keystore --output_folder $env(WORK_DIR)

expect_or_fail {network/chain name} accept_default

expect_or_fail {location of your keystore file} {
    send_line $env(KEYSTORE_PATH)
}
expect_or_fail {password that is used to encrypt the provided keystore} {
    send_line $env(KEYSTORE_PASSWORD)
}
expect_or_fail {validator index of your validator that corresponds} {
    send_line 0
}

# Exit creation, verification, success message and final pause.
expect_success_end
